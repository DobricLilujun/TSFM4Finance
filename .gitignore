.venv/
__pycache__/
*.pyc
.pytest_cache/
.deploy/
*.xml
# large raw downloads (kept locally on the server, not in the repo)
data/bis_raw/*.csv
data/bis_raw/*.zip
data/bis_raw/*.xml

# large model checkpoints / weights (do not push to GitHub)
chronos-2-finetuned/
data/bis/ckpts/
**/model.safetensors
data/bis_raw/
*.safetensors

# Generated outputs that should not be committed by default, but some assets
# are required for CI / GitHub Pages (see explicit force-adds below).
assets/outputs/
assets/data/

# vendored tsfm-trl harness (trl/): run artifacts and local envs stay out of git
trl/envs/*/
trl/envs/local.json
trl/reports/ft*/
trl/reports/reward_demo/*/
trl/site/
trl/.venv*/
trl/.pytest_cache/
trl/.ruff_cache/
trl/*.egg-info/

# flattened CSVs are regenerable with probes/trux/series_to_csv.py; the MANIFEST stays in git
trl/reports/*/series_csv/*
!trl/reports/*/series_csv/MANIFEST.json
# locally cloned model weights (git-lfs; never commit)
models/
# offline HF-cache mirror built by bench.weights --link-into-cache
.hf-cache/

# trainer checkpoints (fine-tuned weights) - never commit
reports/ft_ckpts/
reports/ft_smoke/

# sqlite cell store: a run artifact, not source
reports/state.sqlite3
reports/**/*.sqlite3
