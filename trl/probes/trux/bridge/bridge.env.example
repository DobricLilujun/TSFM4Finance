# Copy to bridge.env (same directory, gitignored) and fill in your own values.
#
# The bridge is how a machine with no inbound route (the DGX Spark worker) is driven from
# the control plane: the worker polls a directory on the control machine over SSH. The
# endpoints - host, user, path, key file - are the only machine-specific parts of every
# probe script, so they live here instead of being baked into tracked files.
#
#   chmod 600 bridge.env
#
# control plane, seen from the worker side (spark_worker.sh, gpu7_*.sh):
BRIDGE_HOST=control.example.edu
BRIDGE_USER=you
BRIDGE_DIR=/scratch/you/spark_bridge
BRIDGE_SSH=ssh -i $HOME/.ssh/id_ed25519_bridge -o StrictHostKeyChecking=accept-new

# the same control plane by the name the job scripts use when pulling data (corpus rsync):
TRUX=you@control.example.edu
TRUX_SSH=ssh -i $HOME/.ssh/id_ed25519_bridge -o StrictHostKeyChecking=accept-new

# where the control plane keeps the job queue and the scored corpus (corpus rsync target):
BRIDGE=/scratch/you/spark_bridge
SRC=/scratch/you/data/standard
TRUX_CSV=/scratch/you/reports/pass3_trux/csv
